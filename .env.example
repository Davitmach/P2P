# =========================
# APP
# =========================

NODE_ENV=production


# =========================
# POSTGRES
# =========================

POSTGRES_USER=p2p
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=p2p_bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Local development
DATABASE_URL=postgresql://p2p:your_postgres_password@localhost:5432/p2p_bot

# Docker
DATABASE_URL_DOCKER=postgresql://p2p:your_postgres_password@postgres:5432/p2p_bot


# =========================
# REDIS
# =========================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password


# =========================
# RABBITMQ
# =========================

RABBITMQ_USER=p2p
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Docker
RABBITMQ_URL=amqp://p2p:your_rabbitmq_password@rabbitmq:5672
RABBITMQ_URL_DOCKER=amqp://p2p:your_rabbitmq_password@rabbitmq:5672


# =========================
# TELEGRAM
# =========================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token


# =========================
# BINANCE
# =========================

BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret